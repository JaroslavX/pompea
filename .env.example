# Copy to .env for local development and for scripts/build-release.sh.  Never commit .env.
# On the server these are NOT read from a file: set them in cPanel -> Setup Node.js App -> Environment variables.

# MongoDB Atlas (database "site", collection "testimonials").
# Use the plain mongodb:// string with the three shard hosts, NOT mongodb+srv:// (its SRV record does not resolve).
# Atlas -> Connect -> Drivers -> older connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb://<db-user>:<db-password>@<shard-00-00-host>:27017,<shard-00-01-host>:27017,<shard-00-02-host>:27017/site?ssl=true&authSource=admin&retryWrites=true&w=majority

# Outgoing mail for the feedback forms (/feedback, /feedback2). Port 465 = SSL.
# Mail is sent from and delivered to SMTP_USER; the visitor's address goes into Reply-To.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=forms@example.com
SMTP_PASS=<mailbox-password>

# Google Analytics 4 Measurement ID. Read at BUILD time: must be set when you run scripts/build-release.sh.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional, local only
# PORT=3000
